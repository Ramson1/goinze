# Public environment variables for the Goinzeschool public website.
# Copy this file to .env.local and adjust as needed.

# Base URL of the Goinzeschool NestJS API.
# Production: https://goinze-backend.vercel.app/api/v1
# Local:      http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=https://goinze-backend.vercel.app/api/v1

# Flutterwave public key for inline payment checkout.
# The frontend fetches this from the API automatically via GET /finance/flutterwave-config.
# You only need this if you want to override the API-provided key.
NEXT_PUBLIC_FLUTTERWAVE_KEY=
FLUTTERWAVE_PUBLIC_KEY="your_flutterwave_public_key"
FLUTTERWAVE_SECRET_KEY="your_flutterwave_secret_key"
FLUTTERWAVE_ENCRYPTION_KEY="your_flutterwave_encryption_key"
FLUTTERWAVE_WEBHOOK_HASH=""
