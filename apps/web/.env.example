# Public environment variables for the Goinzeschool public website.
# Copy this file to .env.local and adjust as needed.

# Base URL of the Goinzeschool NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Flutterwave public key for inline payment checkout.
# The frontend fetches this from the API automatically via GET /finance/flutterwave-config.
# You only need this if you want to override the API-provided key.
NEXT_PUBLIC_FLUTTERWAVE_KEY=
