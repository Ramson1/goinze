# ============================================================
# Goinzeschool — Student Portal environment (example)
# Copy to .env.local and fill in real values. Never commit .env.local.
# ============================================================

# Base URL of the NestJS API consumed by this portal
# Production: https://goinze-backend.vercel.app/api/v1
# Local:      http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=https://goinze-backend.vercel.app/api/v1

# Flutterwave public key (client-side checkout)
NEXT_PUBLIC_FLUTTERWAVE_KEY=

# App
NEXT_PUBLIC_APP_NAME=Goinzeschool Student Portal
